# BUC Dashboard — Environment Variables Reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it must stay in .gitignore.
# This file is safe to commit: placeholder values only.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── GoHighLevel — BuildUp Community (BUC) ─────────────────────────────────────
GHL_PIT_BUC=your_buc_ghl_private_integration_token_here
GHL_LOCATION_ID_BUC=n2gK5CxzjJj4tNIfcKHw

# ── Webhooks ─────────────────────────────────────────────────────────────────
# Shared secret — set this in GHL webhook header (x-webhook-secret) and here
GHL_WEBHOOK_SECRET=your_random_secret_here

# ── Google Sheets (archive / read-only reference) ─────────────────────────────
BUC_SHEET_ID=1y-tME_4wRhoFeLozOcnfNflznECa1Qp6NAGUeM2cKVc
