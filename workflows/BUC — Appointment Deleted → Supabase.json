{
  "name": "BUC — Appointment Deleted → Supabase",
  "status": "published",
  "allowMultiple": true,
  "timezone": "account",
  "removeContactFromLastStep": true,
  "stopOnResponse": false,
  "autoMarkAsRead": false,
  "type": "workflow",
  "allowMultipleOpportunity": true,
  "creationSource": "builder",
  "workflowData": {
    "templates": [
      {
        "id": "buc-delete-step-1",
        "order": 0,
        "attributes": {
          "method": "POST",
          "url": "https://bag-buc-dashboard.vercel.app/api/ghl-webhook",
          "customData": [
            {
              "key": "action",
              "value": "deleted"
            },
            {
              "key": "appointment_id",
              "value": "{{appointment.id}}"
            },
            {
              "key": "contact_id",
              "value": "{{contact.id}}"
            }
          ],
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "name": "Delete from Supabase",
        "type": "webhook"
      }
    ]
  },
  "exportedTriggers": [
    {
      "actions": [],
      "active": true,
      "belongs_to": "workflow",
      "conditions": [
        {
          "field": "appointment.eventType",
          "operator": "==",
          "title": "Event type",
          "type": "select",
          "value": "delete"
        },
        {
          "field": "contactMode",
          "operator": "is-any-of",
          "type": "input",
          "value": [
            "contact"
          ]
        }
      ],
      "filter": "AND",
      "group": "AppointmentDelete",
      "title": "Appointment Deleted",
      "type": "AppointmentDelete"
    }
  ]
}
